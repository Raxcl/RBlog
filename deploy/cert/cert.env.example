# ─── RBlog 证书自动化配置 ───────────────────────────────────────────────
# 用法：复制成 cert.env 再填真实值。
#   cp deploy/cert/cert.env.example ~/.rblog-cert/cert.env
#   chmod 600 ~/.rblog-cert/cert.env
#
# 读取顺序（第一个存在的生效）：
#   $RBLOG_CERT_ENV  >  ~/.rblog-cert/cert.env  >  deploy/cert/cert.env
#
# ⚠ 本仓库是公开的 github.com/Raxcl/RBlog。cert.env 已进 .gitignore，
#   永远不要把它 commit 上去 —— SecretKey 泄露等于整个云账号沦陷。

# ── 腾讯云 API 凭据 ──
# 这套只需要两个权限，缺一个都会在很后面才报错：
#   QcloudDNSPodFullAccess   （acme.sh 加/删 _acme-challenge TXT 记录）
#   QcloudCDNFullAccess      （下发证书到加速域名）
# 复用 COS 那对 key 的话，去 CAM 给它补上这两条策略即可，不用换 key。
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=

# ── 要签发的证书 ──
# 主域名决定 acme.sh 的证书目录名（~/.acme.sh/<CERT_PRIMARY>_ecc/）。
#
# ⚠ 绝对不要和服务器上已有的证书撞名。当前 raxcl.cn（含 www）和 admin.raxcl.cn
#   各自已有一套 HTTP-01 + webroot 的自动续签在跑，撞名的话 --issue 会把那个目录
#   就地改写成 DNS-01，顶掉正在工作的续签。setup-cert.sh 有 guard_no_hijack 拦这
#   种情况，但别指望它，自己先看清楚。
CERT_PRIMARY=cdn.raxcl.cn
# 额外域名，空格分隔，和 CERT_PRIMARY 签成同一张证书。CDN 只认 cdn.raxcl.cn，
# 源站又另有自己的续签，所以默认留空。
# ⚠ 别再往里加 *.raxcl.cn：Let's Encrypt 认为 cdn.raxcl.cn 已被该通配符覆盖，
#   两个同列会直接拒单（400 "redundant with a wildcard domain in the same request"）。
#   check_san_list 会在本地拦住，但源头就别配错。
CERT_SANS=
# Let's Encrypt 到期通知邮箱
CERT_EMAIL=

# ── 要不要连源站 nginx 一起接管 ──
# 0 = 只推 CDN，完全不碰源站证书（推荐：源站 HTTP-01 不依赖任何云 API 凭据，
#     凭据挂了也不影响源站；两者互不牵连）
# 1 = 连源站一起管：分发证书到 nginx 的证书路径 + nginx -t + reload
MANAGE_ORIGIN=0

# 下面两项只在 MANAGE_ORIGIN=1 时才用得上
# 留空则自动探测：找发布了 443 端口的 nginx 容器
NGINX_CONTAINER=
# 宿主机路径，空格分隔的 cert:key 配对。留空则读 nginx -T 里的 ssl_certificate
# 指令，再按 docker 挂载映射回宿主机路径，结果写进 ~/.rblog-cert/resolved.env。
# 手动指定示例：
#   CERT_TARGETS='/mnt/docker/nginx/ssl/raxcl.cn_bundle.crt:/mnt/docker/nginx/ssl/raxcl.cn.key'
CERT_TARGETS=

# ── 需要下发证书的腾讯云 CDN 加速域名（空格分隔）──
CDN_DOMAINS=cdn.raxcl.cn

# ── 体检时探测哪些域名（只影响 --check 和结束时的报告）──
APEX_DOMAIN=raxcl.cn
